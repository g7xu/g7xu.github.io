---
import { author } from '../data/author';

const siteUrl = Astro.site!.origin;

// Every external profile in the author's link list doubles as a sameAs entry.
const profileUrls = author.links
  .map((link) => link.url)
  .filter((url) => url.startsWith('http'));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: siteUrl,
  image: `${siteUrl}${author.avatar}`,
  description: author.siteDescription,
  email: author.email,
  jobTitle: 'Data Science Student',
  worksFor: {
    '@type': 'Organization',
    name: 'University of California San Diego',
  },
  alumniOf: {
    '@type': 'Organization',
    name: 'University of California San Diego',
  },
  sameAs: profileUrls,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: author.siteTitle,
  url: siteUrl,
  description: author.siteDescription,
  author: {
    '@type': 'Person',
    name: author.name,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
