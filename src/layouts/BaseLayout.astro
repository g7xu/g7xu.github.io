---
import { author } from '../data/author';
import { firstScreenSwarm, scrolledSwarm } from '../data/swarm';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import '../styles/global.css';
import '../styles/navbar.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Per-page color theme (sets `data-theme` on <body>). See global.css. */
  theme?: string;
  /**
   * Wrap the page in <cursor-swarm> so a crowd of cursors builds it on the
   * visitor's first view (data/swarm.ts). The page must also import
   * `scripts/swarm.ts` and `styles/swarm.css`; this layout only renders the
   * elements and decides, before paint, whether they will run.
   */
  swarm?: boolean;
}

const {
  title = author.siteTitle,
  description = author.siteDescription,
  image = '/images/bio-photo.png',
  theme = 'workshop',
  swarm = false,
} = Astro.props;

// Runs inline in <head>, before first paint: html.swarm-live gates every
// swarm style and the module script, so the first-visit / reduced-motion
// decision cannot wait for a module that loads after the page has rendered.
// `?swarm` in the URL forces a run. Blocked storage means no swarm at all.
const SWARM_GATE = `try {
  var forced = location.search.indexOf('swarm') !== -1;
  var seen = localStorage.getItem('swarm-seen');
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ((forced || !seen) && !still) document.documentElement.classList.add('swarm-live', 'swarm-arming');
} catch (_) {}`;

// Shell is the custom element on swarm pages and nothing at all elsewhere.
// The footer gets a swarm of its own so the cursors come back for it.
const Shell = swarm ? 'cursor-swarm' : Fragment;
const FooterShell = swarm ? 'cursor-swarm' : Fragment;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle =
  Astro.url.pathname === '/'
    ? author.siteTitle
    : `${title} - ${author.siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" href={author.favicon} />
    <link rel="apple-touch-icon" href={author.favicon} />

    <!-- Manrope: body & headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={author.siteTitle} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <StructuredData />
    <slot name="head" />
    {swarm && <script is:inline set:html={SWARM_GATE} />}
  </head>
  <body data-theme={theme}>
    <Shell {...swarm ? firstScreenSwarm : {}}>
      <Navbar />
      <slot />
      <FooterShell {...swarm ? scrolledSwarm : {}}>
        <Footer />
      </FooterShell>
    </Shell>
    {
      swarm && (
        <button class="swarm-skip" type="button">
          Skip the intro
        </button>
      )
    }
    <script>
      import '../scripts/bilingual.ts';

      document.addEventListener('click', async (e) => {
        const link = (e.target as Element).closest('.copy-email');
        if (!link) return;
        e.preventDefault();
        const email = (link as HTMLElement).dataset.email;
        if (!email) return;
        await navigator.clipboard.writeText(email);
        const tooltip = document.createElement('span');
        tooltip.textContent = 'Copied!';
        tooltip.className = 'copy-tooltip';
        link.appendChild(tooltip);
        setTimeout(() => tooltip.remove(), 1500);
      });
    </script>
  </body>
</html>
