---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { scrolledSwarm } from '../data/swarm';
import '../styles/sidebar.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Passed through to BaseLayout; also gives the full-width slot a swarm of
   * its own, so the cursors come back for it when it scrolls into view.
   */
  swarm?: boolean;
}

const { title, description, swarm = false } = Astro.props;

// The swarm element must be as wide as the viewport (styles/swarm.css says
// why), so it wraps the full-width container rather than sitting inside it.
const FullWidthShell = swarm ? 'cursor-swarm' : Fragment;
---

<BaseLayout title={title} description={description} swarm={swarm}>
  <div class="layout-with-sidebar">
    <aside class="author-sidebar">
      <Sidebar />
    </aside>
    <main class="main-content">
      <slot />
    </main>
  </div>
  <FullWidthShell {...swarm ? scrolledSwarm : {}}>
    <div class="layout-full-width">
      <slot name="full-width" />
    </div>
  </FullWidthShell>
</BaseLayout>

<style>
  .layout-with-sidebar {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    align-items: start;
  }

  /* Two-column mode: the row fills the first screen (navbar is 60px) and
     both columns sit at its vertical middle. */
  @media (min-width: 769px) {
    .layout-with-sidebar {
      min-height: calc(100vh - 60px);
      align-items: center;
    }
  }

  .main-content {
    min-width: 0;
  }

  /* Same container as the grid, so full-width content aligns with the
     sidebar's left edge and the main column's right edge. Horizontal
     padding only, so the wrapper collapses to nothing when the slot is empty. */
  .layout-full-width {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .layout-with-sidebar {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem;
    }

    .author-sidebar {
      order: -1;
    }

    .layout-full-width {
      padding: 0 1rem;
    }
  }
</style>
