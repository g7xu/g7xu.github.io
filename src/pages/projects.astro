---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectsByCategory, getAllTags } from '../data/projects';
import '../styles/projects.css';

const spotlightProjects = getProjectsByCategory('spotlight');
const buildingProjects = getProjectsByCategory('building-the-wheel');
const fullStackProjects = getProjectsByCategory('full-stack-applications');
const dataScienceProjects = getProjectsByCategory('data-science');
const allTags = getAllTags();
---

<BaseLayout title="Projects">
  <main class="projects-page">
    <div class="tag-filter-bar">
      <button class="tag-filter active" data-tag="all">All</button>
      {
        allTags.map((tag) => (
          <button class="tag-filter" data-tag={tag}>
            {tag}
          </button>
        ))
      }
    </div>

    <section class="project-section">
      <h2>Spotlight</h2>
      <hr />
      <div class="projects-grid">
        {spotlightProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="project-section">
      <button class="accordion-toggle" aria-expanded="false">
        <span class="accordion-arrow"></span>
        <h2>Building the Wheel</h2>
      </button>
      <div class="accordion-content">
        <div class="projects-grid">
          {buildingProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <section class="project-section">
      <button class="accordion-toggle" aria-expanded="false">
        <span class="accordion-arrow"></span>
        <h2>Full-Stack Applications</h2>
      </button>
      <div class="accordion-content">
        <div class="projects-grid">
          {
            fullStackProjects.map((project) => (
              <ProjectCard project={project} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="project-section">
      <button class="accordion-toggle" aria-expanded="false">
        <span class="accordion-arrow"></span>
        <h2>Data Science</h2>
      </button>
      <div class="accordion-content">
        <div class="projects-grid">
          {
            dataScienceProjects.map((project) => (
              <ProjectCard project={project} />
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // ── Card click-through ──
  // The card is one big link target, but the GitHub / Website anchors inside
  // it must keep their own destinations, so anchor clicks are left alone.
  const grid = document.querySelector<HTMLElement>('.projects-page');
  const openCard = (card: HTMLElement) => {
    const url = card.dataset.url;
    if (url) window.open(url, '_blank', 'noopener,noreferrer');
  };
  grid?.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('a')) return;
    const card = target.closest<HTMLElement>('.project-item');
    if (card) openCard(card);
  });
  grid?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const card = (e.target as Element).closest<HTMLElement>('.project-item');
    if (!card || card !== e.target) return;
    e.preventDefault();
    openCard(card);
  });

  // ── Accordion sections ──
  document
    .querySelectorAll<HTMLElement>('.accordion-toggle')
    .forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const content = toggle.nextElementSibling as HTMLElement;
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          // height:auto can't be transitioned, so pin the current height for one frame first
          content.style.height = content.scrollHeight + 'px';
          requestAnimationFrame(() => {
            content.style.height = '0';
          });
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          content.style.height = content.scrollHeight + 'px';
          toggle.setAttribute('aria-expanded', 'true');
          // After transition completes, remove fixed height so content reflows naturally
          const onEnd = () => {
            content.style.height = 'auto';
            content.removeEventListener('transitionend', onEnd);
          };
          content.addEventListener('transitionend', onEnd);
        }
      });
    });

  // ── Tag filtering ──
  // Toggleable + multi-select. With several tags selected, a project shows if
  // it matches ANY of them. "All" clears the selection (and is active whenever
  // nothing is selected).
  const filterButtons = document.querySelectorAll<HTMLElement>('.tag-filter');
  const allButton = document.querySelector<HTMLElement>(
    '.tag-filter[data-tag="all"]',
  );
  const sections = document.querySelectorAll<HTMLElement>('.project-section');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('.project-item'),
    (el) => ({
      el,
      tags: JSON.parse(el.dataset.tags ?? '[]') as string[],
    }),
  );
  const selectedTags = new Set<string>();

  const applyFilter = () => {
    filterButtons.forEach((b) => {
      b.classList.toggle('active', selectedTags.has(b.dataset.tag ?? ''));
    });
    allButton?.classList.toggle('active', selectedTags.size === 0);

    for (const { el, tags } of cards) {
      el.hidden =
        selectedTags.size > 0 && !tags.some((t) => selectedTags.has(t));
    }
    sections.forEach((section) => {
      section.hidden =
        section.querySelector('.project-item:not([hidden])') === null;
    });
  };

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      if (tag === 'all') {
        selectedTags.clear();
      } else if (selectedTags.has(tag)) {
        selectedTags.delete(tag);
      } else {
        selectedTags.add(tag);
      }
      applyFilter();
    });
  });

  applyFilter();
</script>
