---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectsByCategory } from '../data/projects';
import '../styles/projects.css';

// Spotlight is always open; the other sections start collapsed.
const projectSections = [
  {
    heading: 'Spotlight',
    projects: getProjectsByCategory('spotlight'),
    collapsible: false,
  },
  {
    heading: 'Building the Wheel',
    projects: getProjectsByCategory('building-the-wheel'),
    collapsible: true,
  },
  {
    heading: 'Full-Stack Applications',
    projects: getProjectsByCategory('full-stack-applications'),
    collapsible: true,
  },
  {
    heading: 'Data Science',
    projects: getProjectsByCategory('data-science'),
    collapsible: true,
  },
];
---

<SidebarLayout
  title="Home"
  description="Personal website of Guoxuan Xu, Data Science student at UC San Diego."
>
  <section class="home-hero">
    <p class="home-hero__lead">
      Hi, I am Jason. I care about writing good code, building meaningful
      products, and speaking with users who are impacted by my code and use my
      products.
    </p>
    <p class="home-hero__body">
      This is a place where I share my projects, my learning, and my feelings —
      keeping track of my growth. I will be interning at Samsung in the summer
      of 2026 in Plano Texas, and studying Master of Computer Science at
      Stanford starting Sep 2026 in Palo Alto. Love to chat or meet up for
      career, startup ideas, projects, or <strong>FOOD!!</strong>
    </p>
  </section>

  <div class="home-projects" slot="full-width">
    {
      projectSections.map(({ heading, projects, collapsible }, i) => (
        <section class="project-section" style={`--i: ${i}`}>
          {collapsible ? (
            <button class="accordion-toggle" aria-expanded="false">
              <span class="accordion-arrow" />
              <h2>{heading}</h2>
            </button>
          ) : (
            <>
              <h2>{heading}</h2>
              <hr />
            </>
          )}
          <div class={collapsible ? 'accordion-content' : undefined}>
            <div class="projects-grid">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>
</SidebarLayout>

<script>
  // The card is one big link target, but the GitHub / Website anchors inside
  // it must keep their own destinations, so anchor clicks are left alone.
  const root = document.querySelector<HTMLElement>('.home-projects');
  const openCard = (card: HTMLElement) => {
    const url = card.dataset.url;
    if (url) window.open(url, '_blank', 'noopener,noreferrer');
  };
  root?.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('a')) return;
    const card = target.closest<HTMLElement>('.project-item');
    if (card) openCard(card);
  });
  root?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const card = (e.target as Element).closest<HTMLElement>('.project-item');
    if (!card || card !== e.target) return;
    e.preventDefault();
    openCard(card);
  });

  // ── Accordion sections ──
  document
    .querySelectorAll<HTMLElement>('.accordion-toggle')
    .forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const content = toggle.nextElementSibling as HTMLElement;
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          // height:auto can't be transitioned, so pin the current height for one frame first
          content.style.height = content.scrollHeight + 'px';
          requestAnimationFrame(() => {
            content.style.height = '0';
          });
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          content.style.height = content.scrollHeight + 'px';
          toggle.setAttribute('aria-expanded', 'true');
          // After transition completes, remove fixed height so content reflows naturally
          const onEnd = () => {
            content.style.height = 'auto';
            content.removeEventListener('transitionend', onEnd);
          };
          content.addEventListener('transitionend', onEnd);
        }
      });
    });
</script>

<style>
  .home-hero {
    padding-top: 3rem;
  }

  .home-hero__lead {
    max-width: 40rem;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
    animation: home-slide-right 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: 0.1s;
  }

  .home-hero__body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    margin: 1.5rem 0 0;
    animation: home-slide-right 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: 0.28s;
  }

  @keyframes home-slide-right {
    from {
      opacity: 0;
      transform: translateX(32px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__lead,
    .home-hero__body {
      animation: none;
    }
  }

  .home-hero__body strong {
    font-weight: 700;
  }

  /* Wide viewports: .home-hero__body indents 12rem to sit at the lead's
     optical center, and may run past the lead's right edge. */
  @media (min-width: 900px) {
    .home-hero__lead {
      font-size: 2.5rem;
    }

    .home-hero__body {
      margin-top: 3rem;
      margin-left: 12rem;
      max-width: 38rem;
    }
  }
</style>
