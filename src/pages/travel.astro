---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/travel.css';
import { coffeeShops } from '../data/coffeeShops';
import {
  geoNaturalEarth1,
  geoPath,
  geoContains,
  geoDistance,
  geoCentroid,
} from 'd3-geo';
import { feature } from 'topojson-client';
import type { GeometryCollection, Topology } from 'topojson-specification';
import type { Feature, Geometry } from 'geojson';
import worldTopoJson from 'world-atlas/countries-110m.json';
import usStatesTopoJson from 'us-atlas/states-10m.json';
import usCountiesTopoJson from 'us-atlas/counties-10m.json';

// Eager-import every photo so a filename string in coffeeShops.ts resolves to
// an optimized image at build time (no per-photo ESM import by hand).
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/travel/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
// Pre-optimize each photo to a square ~300px webp (the polaroid renders at 150,
// so 300 = 2× retina) and map by bare filename → optimized URL. Done in the
// frontmatter (not via <Image> in the loop, which trips the Astro compiler).
const travelPhotoSrc: Record<string, string> = {};
await Promise.all(
  Object.entries(photoModules).map(async ([path, mod]) => {
    const out = await getImage({
      src: mod.default,
      width: 300,
      height: 300,
      fit: 'cover',
      position: 'center',
      format: 'webp',
    });
    travelPhotoSrc[path.split('/').pop()!] = out.src;
  }),
);
const resolvePhoto = (src?: string): string | undefined =>
  src ? travelPhotoSrc[src] : undefined;

// --- Build the illustrated world map at build time (no client mapping library) ---
const WIDTH = 975;
const HEIGHT = 610;

// The atlas JSON files are typed structurally by the bundler (e.g. `type:
// string`), so they are asserted to the TopoJSON shapes their docs promise.
type NamedProps = { name: string };
type Region = Feature<Geometry, NamedProps>;
type AtlasTopology<K extends string> = Topology<
  Record<K, GeometryCollection<NamedProps>>
>;
const worldTopo = worldTopoJson as unknown as AtlasTopology<'countries'>;
const usStatesTopo = usStatesTopoJson as unknown as AtlasTopology<'states'>;
const usCountiesTopo =
  usCountiesTopoJson as unknown as AtlasTopology<'counties'>;

const worldGeo = feature(worldTopo, worldTopo.objects.countries);
const countryFeatures: Region[] = worldGeo.features.filter(
  (f) => f.properties.name !== 'Antarctica',
);
const projection = geoNaturalEarth1().fitSize([WIDTH, HEIGHT], {
  type: 'FeatureCollection',
  features: countryFeatures,
});
const pathGen = geoPath(projection);

const boundsStr = (f: Region) => {
  const [[x0, y0], [x1, y1]] = pathGen.bounds(f);
  return [x0, y0, x1, y1].map((n) => Math.round(n)).join(',');
};

const stateFeatures: Region[] = feature(
  usStatesTopo,
  usStatesTopo.objects.states,
).features;
const countyFeatures: Region[] = feature(
  usCountiesTopo,
  usCountiesTopo.objects.counties,
).features;

// County FIPS ids start with their state's two-digit FIPS, which is how a
// county is matched to its state below.
const stateIdOf = (county: Region) => String(county.id).slice(0, 2);
const countiesByState = new Map<string, Region[]>();
for (const county of countyFeatures) {
  const stateId = stateIdOf(county);
  const bucket = countiesByState.get(stateId);
  if (bucket) bucket.push(county);
  else countiesByState.set(stateId, [county]);
}

// Which regions actually contain a shop — only these are clickable/zoomable.
// Coastal points (e.g. La Jolla) can fall just outside a simplified polygon,
// so if nothing contains the point we snap it to the nearest region.
const nearest = (features: Region[], pt: [number, number]) => {
  let best: Region | null = null;
  let bestD = Infinity;
  for (const f of features) {
    const d = geoDistance(geoCentroid(f), pt);
    if (d < bestD) {
      bestD = d;
      best = f;
    }
  }
  return best;
};
const containingOrNearest = (features: Region[], pt: [number, number]) =>
  features.find((f) => geoContains(f, pt)) ?? nearest(features, pt);

const shopCountryNames = new Set<string>();
const shopStateIds = new Set<string>();
const shopCountyIds = new Set<string>();
for (const s of coffeeShops) {
  const pt: [number, number] = [s.lng, s.lat];
  const c = countryFeatures.find((f) => geoContains(f, pt));
  if (c) shopCountryNames.add(c.properties.name);
  const st = containingOrNearest(stateFeatures, pt);
  const stId = st ? String(st.id) : '';
  if (st) shopStateIds.add(stId);
  // Match the county within the shop's state (fast + avoids cross-state snaps).
  const co = containingOrNearest(
    countiesByState.get(stId) ?? countyFeatures,
    pt,
  );
  if (co) shopCountyIds.add(String(co.id));
}

interface MapRegion {
  id: string;
  name: string;
  d: string;
  bounds: string;
  hasPin: boolean;
}
const toMapRegion = (f: Region, hasPin: boolean): MapRegion => ({
  id: String(f.id),
  name: f.properties.name,
  d: pathGen(f) ?? '',
  bounds: boundsStr(f),
  hasPin,
});
const withPath = (r: MapRegion) => r.d !== '';

const countries = countryFeatures
  .map((f) => toMapRegion(f, shopCountryNames.has(f.properties.name)))
  .filter(withPath);

// Tier 1 — US states (the grid revealed when you zoom into the U.S.)
const states = stateFeatures
  .map((f) => toMapRegion(f, shopStateIds.has(String(f.id))))
  .filter(withPath);

// Tier 2 — counties (the "city grid"), scoped to states that actually have shops
// so the page stays light. Auto-expands as shops in new states are added.
const counties = [...shopStateIds]
  .flatMap((stateId) => countiesByState.get(stateId) ?? [])
  .map((f) => toMapRegion(f, shopCountyIds.has(String(f.id))))
  .filter(withPath);

// Project each shop (works for any lng/lat on Earth). Photo filenames are
// resolved here once so the template never re-runs the lookup.
const pins = coffeeShops.flatMap((s) => {
  const xy = projection([s.lng, s.lat]);
  if (!xy) return [];
  return [
    {
      ...s,
      x: xy[0],
      y: xy[1],
      photos: s.photos.map((ph) => ({ ...ph, url: resolvePhoto(ph.src) })),
    },
  ];
});

const tilt = (n: number) => (((n * 37) % 13) - 6) * 0.9;

const sparkles = [
  { x: 120, y: 90 },
  { x: 470, y: 60 },
  { x: 720, y: 120 },
  { x: 880, y: 330 },
  { x: 250, y: 470 },
  { x: 600, y: 520 },
];

const shopCount = pins.length;
---

<BaseLayout title="Coffee Map" theme="coffee">
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
    slot="head"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Patrick+Hand&display=swap"
    slot="head"
  />

  <style is:global>
    html,
    body {
      overflow: hidden;
      height: 100%;
    }
    body > footer {
      display: none;
    }
  </style>

  <main class="travel">
    <p class="travel-line">
      I've worked from <em>{shopCount}</em> coffee shop{
        shopCount === 1 ? '' : 's'
      } across the U.S.
    </p>

    <div class="map-wrap">
      <button class="map-back" id="map-back" hidden>← Zoom out</button>

      <svg
        class="us-map lod-world"
        id="us-map"
        viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
        role="img"
        aria-label="Illustrated world map with coffee-shop pins"
      >
        <g class="zoom-layer" id="zoom-layer">
          <g class="countries">
            {
              countries.map((c) => (
                <path
                  d={c.d}
                  class={`country${c.hasPin ? ' has-pin' : ''}`}
                  data-name={c.name}
                  data-bounds={c.bounds}
                  tabindex={c.hasPin ? '0' : '-1'}
                  role="button"
                  aria-label={c.hasPin ? `Zoom into ${c.name}` : c.name}
                />
              ))
            }
          </g>

          <g class="states">
            {
              states.map((s) => (
                <path
                  d={s.d}
                  class={`state${s.hasPin ? ' has-pin' : ''}`}
                  data-name={s.name}
                  data-bounds={s.bounds}
                  tabindex={s.hasPin ? '0' : '-1'}
                  role="button"
                  aria-label={s.hasPin ? `Zoom into ${s.name}` : s.name}
                />
              ))
            }
          </g>

          <g class="counties">
            {
              counties.map((c) => (
                <path
                  d={c.d}
                  class={`county${c.hasPin ? ' has-pin' : ''}`}
                  data-name={c.name}
                  data-bounds={c.bounds}
                  tabindex={c.hasPin ? '0' : '-1'}
                />
              ))
            }
          </g>

          <g class="sparkles" aria-hidden="true">
            {
              sparkles.map((p) => (
                <path
                  class="sparkle"
                  transform={`translate(${p.x} ${p.y})`}
                  d="M0,-7 C0.6,-2 2,-0.6 7,0 C2,0.6 0.6,2 0,7 C-0.6,2 -2,0.6 -7,0 C-2,-0.6 -0.6,-2 0,-7 Z"
                />
              ))
            }
          </g>

          <g class="pins">
            {
              pins.map((p, i) => (
                <g
                  class="pin"
                  transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}
                  data-id={p.id}
                  data-x={p.x.toFixed(2)}
                  data-y={p.y.toFixed(2)}
                  role="button"
                  tabindex="0"
                  aria-label={`${p.name}, ${p.city}`}
                  style={`--hue:${p.hue}; --i:${i}`}
                >
                  <g class="pin-pop">
                    <g class="pin-scale">
                      <g class="pin-fan">
                        <circle class="pin-pulse" cx="0" cy="-15" r="9" />
                        <circle class="pin-hit" cx="0" cy="-15" r="17" />
                        <path
                          class="pin-teardrop"
                          d="M0 0 C -4 -7 -9 -10 -9 -15 A 9 9 0 1 1 9 -15 C 9 -10 4 -7 0 0 Z"
                        />
                        <circle class="pin-center" cx="0" cy="-15" r="3.4" />
                        <text
                          class="pin-flag-text"
                          y="-32"
                          text-anchor="middle"
                        >
                          {p.name}
                        </text>
                        {/* Count badge, shown when this pin represents a
                            cluster of nearby shops (set by updateDeclutter). */}
                        <g class="pin-count" aria-hidden="true">
                          <circle cx="8.5" cy="-25" r="6.5" />
                          <text x="8.5" y="-21.6">
                            2
                          </text>
                        </g>
                      </g>
                    </g>
                  </g>
                </g>
              ))
            }
          </g>
        </g>
      </svg>
    </div>
  </main>

  <!-- Collage overlay (one panel per shop, toggled by JS) -->
  <div class="collage-overlay" id="collage-overlay" hidden>
    <div class="collage-backdrop" data-close></div>
    {
      pins.map((p) => (
        <article class="collage" data-id={p.id} hidden style={`--hue:${p.hue}`}>
          <button class="collage-close" data-close aria-label="Close">
            ×
          </button>
          <div class="collage-head">
            <h2 class="collage-name">{p.name}</h2>
            <p class="collage-city">
              📍 {p.address ?? p.city}
              {p.date && <span> · {p.date}</span>}
            </p>
          </div>
          <div class="polaroids">
            {p.photos.map((ph, i) => (
              <figure
                class="polaroid"
                style={`--tilt:${tilt(i + p.name.length)}deg`}
              >
                <div class="polaroid-img" style={`--hue:${p.hue}`}>
                  {ph.url && (
                    <img
                      src={ph.url}
                      alt={ph.caption ?? p.name}
                      width="300"
                      height="300"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                {ph.caption && <figcaption>{ph.caption}</figcaption>}
              </figure>
            ))}
          </div>
          {p.note && <p class="collage-note">{p.note}</p>}
        </article>
      ))
    }
  </div>
</BaseLayout>

<script>
  import '../scripts/travel.ts';
</script>
